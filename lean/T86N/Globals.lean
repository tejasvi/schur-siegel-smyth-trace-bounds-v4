import T86Core.Leaves
import T86Core.CheckE

/-! Global checks of the 86a lower-bound certificate (N): data, energy, tails. Generated by tools/gen86_nshards.py. -/

set_option maxRecDepth 200000
set_option maxHeartbeats 0

namespace T86Core.T86N

theorem data_ok : dataOK = true := by native_decide

/-- `I ≥ iLoNum / 2^128`: the energy blocks give `I ≥ iBlock.1 / (12 · 10^48 · 2^300)`. -/
theorem energy_ok : decide ((iLoNum : Int) * 12 * 10 ^ 48 * 2 ^ 300 ≤ (iBlock 0 10388).1 * 2 ^ 128) = true := by
  native_decide

theorem left_tail_ok : (leftTailPre 10000000000 0 && decide (0 < leftTailLB (mkCtx iLoNum 128) 10000000000 0)) = true := by
  native_decide

theorem right_tail_ok : (rightTailPre 30000000000000 && decide (0 < rightTailLB (mkCtx iLoNum 128) 30000000000000)) = true := by
  native_decide

end T86Core.T86N
