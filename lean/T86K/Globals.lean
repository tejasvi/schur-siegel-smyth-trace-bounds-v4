import T86Core.Lits
import T86Core.Leaves

/-! Global checks of the 86a lower-bound certificate (K): data, energy, tails. Generated by tools/gen86_nshards.py. -/

set_option maxRecDepth 200000
set_option maxHeartbeats 0

namespace T86Core.T86K

theorem data_ok : dataOK = true := by decide +kernel


theorem left_tail_ok : (leftTailPre 10000000000 0 && decide (0 < leftTailLB ctxLit 10000000000 0)) = true := by
  decide +kernel

theorem right_tail_ok : (rightTailPre 30000000000000 && decide (0 < rightTailLB ctxLit 30000000000000)) = true := by
  decide +kernel

end T86Core.T86K
